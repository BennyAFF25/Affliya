# Shopify stage one (server only; never prefix secrets with NEXT_PUBLIC_)
SHOPIFY_CLIENT_ID=504d490cc8b4e692142ff5713bfa6de3
SHOPIFY_CLIENT_SECRET=
# Optional separate OAuth state signing secret; falls back to SHOPIFY_CLIENT_SECRET
SHOPIFY_STATE_SECRET=
# Required: random 32 bytes encoded as base64 or 64 hex characters
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_SCOPES=write_pixels,read_customer_events
SHOPIFY_API_VERSION=2026-10
# Canonical webhook/pixel origin: use https://www.nettmark.com in production. OAuth uses request origin.
NEXT_PUBLIC_BASE_URL=
# Existing server client requirements
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Official Shopify App Store listing URL from the Dev Dashboard (required for Nettmark-initiated connect).
# Set after the listing URL is confirmed; do not invent an app handle.
SHOPIFY_APP_STORE_URL=

# Shopify recurring Growth billing (defaults: 49.00 AUD / 30 days; test outside explicitly enabled production)
SHOPIFY_GROWTH_PRICE_AMOUNT=
SHOPIFY_GROWTH_PRICE_USD_AMOUNT=
SHOPIFY_BILLING_TEST=

SHOPIFY_BILLED_PLATFORM_FEE_ENABLED=

# Growth Partner programme (configure per environment)
NON_PRODUCTION_EMAIL_ALLOWLIST=
GROWTH_PARTNER_ASSUME_AUD_GST_INCLUSIVE=
GROWTH_PARTNER_COMMISSION_HOLD_DAYS=
GROWTH_PARTNER_IP_HASH_SALT=
CREATOR_REFERRAL_ATTRIBUTION_WINDOW_DAYS=
ADMIN_NOTIFY_EMAIL=

# Refund policy / terms acceptance / billing emails (all default off)
# Terms v2 (draft clause 7, signup + trial checkboxes, server-side acceptance, 409 at checkout). Needs a redeploy (NEXT_PUBLIC_).
NEXT_PUBLIC_TERMS_V2_ENABLED=
# Stripe Checkout ToS checkbox + custom text. Requires the ToS URL in Stripe → Settings → Public details first.
CHECKOUT_TOS_CONSENT_ENABLED=
# Billing emails ledger + cron (trial started, receipts, cancellation, non-payment, refund).
BILLING_NOTIFICATIONS_ENABLED=
# Optional comma list of kinds to send; blank = all. e.g. trial_started,subscription_cancel_scheduled,subscription_ended,cancelled_nonpayment
BILLING_NOTIFICATION_KINDS=
# Day-12/E3 billing reminder for every cohort, based on trial end.
TRIAL_BILLING_REMINDERS_V2_ENABLED=
# Optional Nettmark day-7 reminder (E2). Keep off while Stripe's 7-day trial reminder is on.
NETTMARK_DAY7_TRIAL_REMINDER=
# Optional test-mode Stripe portal login link for Preview/staging emails.
STRIPE_BILLING_PORTAL_LOGIN_URL=
