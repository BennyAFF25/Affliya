# Shopify stage one (server only; never prefix secrets with NEXT_PUBLIC_)
SHOPIFY_CLIENT_ID=504d490cc8b4e692142ff5713bfa6de3
SHOPIFY_CLIENT_SECRET=
# Optional separate OAuth state signing secret; falls back to SHOPIFY_CLIENT_SECRET
SHOPIFY_STATE_SECRET=
# Required: random 32 bytes encoded as base64 or 64 hex characters
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_SCOPES=write_pixels,read_customer_events
SHOPIFY_API_VERSION=2026-10
# Canonical webhook/pixel origin: use https://www.nettmark.com in production. OAuth uses request origin.
NEXT_PUBLIC_BASE_URL=
# Existing server client requirements
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Official Shopify App Store listing URL from the Dev Dashboard (required for Nettmark-initiated connect).
# Set after the listing URL is confirmed; do not invent an app handle.
SHOPIFY_APP_STORE_URL=

# Shopify recurring Growth billing (defaults: 49.00 AUD / 30 days; test outside explicitly enabled production)
SHOPIFY_GROWTH_PRICE_AMOUNT=
SHOPIFY_GROWTH_PRICE_USD_AMOUNT=
SHOPIFY_BILLING_TEST=
