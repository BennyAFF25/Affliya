# Shopify stage one (server only; never prefix secrets with NEXT_PUBLIC_)
SHOPIFY_CLIENT_ID=504d490cc8b4e692142ff5713bfa6de3
SHOPIFY_CLIENT_SECRET=
# Optional separate OAuth state signing secret; falls back to SHOPIFY_CLIENT_SECRET
SHOPIFY_STATE_SECRET=
# Required: random 32 bytes encoded as base64 or 64 hex characters
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_SCOPES=read_products,write_pixels,read_customer_events
SHOPIFY_API_VERSION=2026-10
# Optional canonical webhook origin; defaults to request origin. OAuth always uses request origin.
NEXT_PUBLIC_BASE_URL=
# Existing server client requirements
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
